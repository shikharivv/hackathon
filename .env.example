# NVIDIA hosted inference: no local GPU required
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# TF-IDF evidence score, NOT a probability of correctness; tune with your FAQ set.
CONFIDENCE_THRESHOLD=0.15
# direct = single Streamlit deployment; api = optional separate FastAPI backend
APP_MODE=direct
API_BASE_URL=http://localhost:8000/api/v1
